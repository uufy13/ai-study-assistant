# AI Study Assistant 环境变量模板
# 使用方法：复制本文件为 .env，填入你实际使用的密钥。
# 安全提示：.env 已被 .gitignore 排除，绝不会进入版本库。
#           切勿把真实密钥写入本模板或提交到 Git。
#
# 只填你实际使用的厂商对应的变量即可（config.yaml 的 provider 决定用哪个）。
# base_url 和 model 已内置在各厂商 preset 中，无需在此配置。

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# DeepSeek
DEEPSEEK_API_KEY=sk-your-key-here

# Kimi (Moonshot)
KIMI_API_KEY=sk-your-key-here

# 通义千问 (Qwen)
QWEN_API_KEY=sk-your-key-here

# Ollama（本地运行）无需 API Key，不填任何变量。
