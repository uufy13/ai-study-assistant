# OpenAI 兼容 API 配置模板
# 使用方法：复制本文件为 .env，填入你自己的密钥。
# .env 已被 .gitignore 排除，绝不会进入版本库。
#
# 设计目标：不绑定单一厂商。任一 OpenAI 兼容服务都可用，
# 只需修改下面的 base_url / api_key / model 三个值。

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# 常见厂商示例（取消注释即可切换）：
# DeepSeek:  https://api.deepseek.com/v1         model: deepseek-chat
# Kimi:      https://api.moonshot.cn/v1          model: moonshot-v1-8k
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama:    http://localhost:11434/v1           model: qwen2.5
