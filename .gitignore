# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# === uv ===
.uv/

# === 环境变量与密钥（绝不能入库） ===
.env
.env.*
!.env.example

# === 本地配置（真实配置不入库，仅示例模板入库） ===
config.yaml
config.local.*
config.*.local

# === 凭证与密钥文件（绝不能入库） ===
secrets.*
credentials.*
*.pem
*.key
id_rsa
id_ed25519

# === 测试与缓存 ===
.pytest_cache/
.pytest-*/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# === IDE / 编辑器 ===
.idea/
.vscode/
*.swp

# === 学习资料与输出（个人/版权敏感，不入库） ===
data/
output/
notes/

# === 真实用户资料（默认不入库） ===
*.docx
*.pdf
*.pptx

# === 保留脱敏的演示与测试文件 ===
!demo/
!demo/**
!tests/fixtures/
!tests/fixtures/**

# === 日志 ===
*.log
debug.log

# === DSH 会话内部数据（非项目内容） ===
_prev_session/

# === 系统文件 ===
Thumbs.db
.DS_Store

# === gitleaks 临时解压目录（仅本机扫描用，绝不入库） ===
.gitleaks/
